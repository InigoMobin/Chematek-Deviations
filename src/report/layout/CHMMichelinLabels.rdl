  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BarcodeFontSize(ByVal Value As Object, ByVal WidthInch As Double) As String
    ' Approx. width of one Code 39 character = 0.0177 inch per font point (IDAutomation C39 fonts)
    Dim CharCount As Integer = 0
    If Not Value Is Nothing Then CharCount = Len(CStr(Value))
    If CharCount = 0 Then Return "10pt"
    Dim Size As Double = ((WidthInch - 0.06) * 0.95) / (CharCount * 0.0177)
    If Size &gt; 14 Then Size = 14
    If Size &lt; 5 Then Size = 5
    Return CStr(CInt(Math.Floor(Size))) &amp; "pt"
End Function
</Code>
